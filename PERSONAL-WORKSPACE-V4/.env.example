# Runtime
APP_MODE=standalone
WORKSPACE_VARIANT=personal
PERSONAL_AUTO_LOGIN=true
PERSONAL_PROJECT_ROOT=
PERSONAL_DEFAULT_FOLDER_PROFILE=Full Lighting Design
LUMINAIRE_EXPORTER_PATH=./tools/luminaire-exporter/SCLI Luminaire Studio.exe
NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:5173
COMPANY_TIMEZONE=Asia/Dubai
LOG_LEVEL=info

# Standalone mode: no Microsoft tenant or IT approval required.
STANDALONE_DB_PATH=./data/scli.sqlite
STANDALONE_SESSION_SECRET=development-only-change-this-secret-2026
STANDALONE_SESSION_HOURS=12
STANDALONE_ADMIN_NAME=System Administrator
STANDALONE_ADMIN_EMAIL=admin@scientechnic.local
STANDALONE_ADMIN_PASSWORD=ChangeThisNow!2026

# Teams and Microsoft Entra (required only for APP_MODE=m365)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_CLIENT_CERTIFICATE_PATH=
ENTRA_CLIENT_CERTIFICATE_PASSWORD=
TEAMS_APP_ID=
TAB_ENDPOINT=https://example.company.com

# Microsoft Graph and SharePoint (required only for APP_MODE=m365)
SHAREPOINT_SITE_ID=
SP_LIST_APP_USERS_ID=
SP_LIST_PROJECTS_ID=
SP_LIST_ACTIVITIES_ID=
SP_LIST_COMMENTS_ID=
SP_LIST_NOTIFICATIONS_ID=
SP_LIST_SEQUENCE_ID=
SP_LIST_PROJECT_TYPES_ID=
SP_LIST_SETTINGS_ID=
SP_SEQUENCE_ITEM_ID=

# Optional proactive Teams notifications
TEAMS_NOTIFICATIONS_ENABLED=false
TEAMS_BOT_ID=
TEAMS_BOT_SECRET=
