{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.23/MicrosoftTeams.schema.json",
  "manifestVersion": "1.23",
  "version": "1.0.0",
  "id": "${{TEAMS_APP_ID}}",
  "developer": {
    "name": "SCLI",
    "websiteUrl": "${{TAB_ENDPOINT}}",
    "privacyUrl": "${{TAB_ENDPOINT}}/privacy.html",
    "termsOfUseUrl": "${{TAB_ENDPOINT}}/terms.html"
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "name": {
    "short": "SCLI Lighting",
    "full": "SCLI Lighting Project Workspace"
  },
  "description": {
    "short": "Coordinate and deliver SCLI lighting projects.",
    "full": "A secure internal workspace for lighting project requests, team workload, collaboration, delivery tracking, reports and audited activity."
  },
  "accentColor": "#008C95",
  "staticTabs": [
    {
      "entityId": "scli-project-tracker",
      "name": "Lighting Projects",
      "contentUrl": "${{TAB_ENDPOINT}}/",
      "websiteUrl": "${{TAB_ENDPOINT}}/",
      "scopes": ["personal"]
    }
  ],
  "bots": [
    {
      "botId": "${{TEAMS_BOT_ID}}",
      "scopes": ["personal"],
      "isNotificationOnly": true,
      "supportsFiles": false
    }
  ],
  "permissions": ["identity"],
  "validDomains": ["${{TAB_DOMAIN}}"],
  "webApplicationInfo": {
    "id": "${{ENTRA_CLIENT_ID}}",
    "resource": "api://${{TAB_DOMAIN}}/${{ENTRA_CLIENT_ID}}"
  }
}
